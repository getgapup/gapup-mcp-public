{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.getgapup/gapup-mcp",
  "version": "0.2.3",
  "description": "271+ agent-payable C-suite expertise tools — x402 USDC/EURC, free tier 100 calls/mo.",
  "homepage": "https://hub.gapup.io/agents-api",
  "documentation": "https://github.com/getgapup/gapup-mcp-public/blob/main/docs/EXAMPLES.md",
  "repository": {
    "url": "https://github.com/getgapup/gapup-mcp-public",
    "source": "github"
  },
  "license": "MIT",
  "author": {
    "name": "Gapup",
    "url": "https://hub.gapup.io",
    "email": "agents@gapup.io"
  },
  "categories": [
    "business-intelligence",
    "finance",
    "compliance",
    "strategy",
    "sales",
    "sustainability",
    "research",
    "healthcare",
    "real-estate",
    "security"
  ],
  "tags": [
    "x402",
    "agent-payable",
    "usdc",
    "eurc",
    "c-suite",
    "competitive-intel",
    "sec-filings",
    "sanctions",
    "kyc",
    "pentest",
    "attack-surface",
    "clinical-evidence",
    "pubmed",
    "openalex",
    "openfda",
    "real-estate",
    "dvf-cerema",
    "georisques",
    "industry-classifier",
    "naics",
    "research-paper-qa",
    "sentiment-news",
    "gdelt",
    "infra-design",
    "esg",
    "ai-act",
    "gdpr",
    "csrd",
    "cerebras",
    "dual-audience",
    "multilingual"
  ],
  "transport": "http",
  "endpoint": "https://mcp.gapup.io/mcp",
  "install": {
    "http": {
      "type": "streamable-http",
      "url": "https://mcp.gapup.io/mcp",
      "auth_header": "x-api-key"
    },
    "smithery": "smithery mcp add getgapup/gapup-mcp"
  },
  "config": {
    "env": [
      {
        "name": "GAPUP_API_KEY",
        "required": true,
        "description": "Free tier 100 calls/mo. Get key at https://hub.gapup.io/agents-api/onboard"
      },
      {
        "name": "GAPUP_API_BASE_URL",
        "required": false,
        "description": "Override Gapup API endpoint. Default: https://hub.gapup.io"
      }
    ]
  },
  "alternatives": [
    {
      "type": "smithery",
      "url": "https://smithery.ai/servers/getgapup/gapup-mcp"
    },
    {
      "type": "github",
      "url": "https://github.com/getgapup/gapup-mcp-public"
    }
  ]
}
